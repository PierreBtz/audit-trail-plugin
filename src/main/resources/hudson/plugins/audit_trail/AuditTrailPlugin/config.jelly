<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
  <f:section title="${%Audit Trail}">
    <f:entry title="${%Rules}">
      <j:invokeStatic var="ruleDescriptors" className="hudson.plugins.audit_trail.rule.Rule" method="all"/>
      <f:hetero-list name="rules" hasHeader="true"
          descriptors="${ruleDescriptors}" items="${descriptor.rules}"
          addCaption="${%Add Rule}"/>
    </f:entry>
    <f:advanced>
      <f:entry title="${%Display Username instead of UserID}">
        <f:checkbox name="displayUserName" checked="${descriptor.displayUserName}"/>
      </f:entry>
    </f:advanced>
  </f:section>
</j:jelly>
